# MongoDB connection string (Prisma requires a replica set, e.g. MongoDB Atlas)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/db-name"

# Post images (AWS S3). Credentials are used on the server only.
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET_NAME="bucket-name"
AWS_S3_BUCKET_URL="https://bucket-name.s3.eu-central-1.amazonaws.com"
# Public URL the browser loads images from (not a secret)
NEXT_PUBLIC_AWS_S3_BUCKET_URL="https://bucket-name.s3.eu-central-1.amazonaws.com"
