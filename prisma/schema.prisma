generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  fullName  String
  email     String   @unique
  phone     String?
  company   String?
  notes     Note[]
  posts     Post[]
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Note {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String // plain text (serializeToPlainText), used for search / previews
  rawContent String // HTML output of the editor (serializeToHtml)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @db.ObjectId
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("notes")
}

enum PostStatus {
  draft
  inReview
  published
}

model Post {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  content    String // plain text (serializeToPlainText), used for search / previews
  rawContent String // HTML output of the editor (serializeToHtml)
  status     PostStatus @default(draft)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String     @db.ObjectId
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("posts")
}

enum UserRole {
  admin
  moderator
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(moderator)
  sessions  Session[]
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Session {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String   @db.ObjectId
  accessTokenHash       String   @unique
  refreshTokenHash      String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  isDeleted             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}
