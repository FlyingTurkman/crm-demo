generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  fullName  String
  email     String   @unique
  phone     String?
  company   String?
  notes     Note[]
  posts     Post[]
  // Normalized copy of the searchable fields, maintained by lib/src/searchText.ts (never written by hand)
  searchText String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Note {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String // plain text (serializeToPlainText), used for search / previews
  rawContent String // HTML output of the editor (serializeToHtml)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @db.ObjectId
  // Normalized copy of the searchable fields, maintained by lib/src/searchText.ts (never written by hand)
  searchText String?
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("notes")
}

enum PostStatus {
  draft
  inReview
  published
}

model Post {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  content    String // plain text (serializeToPlainText), used for search / previews
  rawContent String // HTML output of the editor (serializeToHtml)
  status     PostStatus @default(draft)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String     @db.ObjectId
  // Normalized copy of the searchable fields, maintained by lib/src/searchText.ts (never written by hand)
  searchText String?
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("posts")
}

enum UserRole {
  admin
  moderator
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(moderator)
  sessions  Session[]
  apiTokens ApiToken[]
  // Normalized copy of the searchable fields, maintained by lib/src/searchText.ts (never written by hand)
  searchText String?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Session {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String   @db.ObjectId
  accessTokenHash       String   @unique
  refreshTokenHash      String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  isDeleted             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// REST API (/api/v1) access token of a user, sent as "Authorization: Bearer <token>".
// Only the SHA-256 hash is stored. A user has one active token, regenerating it
// soft-deletes the old one.
model ApiToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.ObjectId
  tokenHash  String    @unique
  lastUsedAt DateTime?
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("apiTokens")
}
